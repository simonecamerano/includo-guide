# Core
PORT=3001

# Text generation (the only external provider this application uses)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5

# Local embeddings (no API key, no external call: the model runs in-process)
# Defaults are fine. Weights are baked into the Docker image at build time.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_CACHE_DIR=./.models

# Admin ingest protection
ADMIN_INGEST_TOKEN=change_this_with_a_long_random_secret

# Session storage (anonymous sessions)
SESSIONS_DIR=./data
SESSION_TTL_MS=2592000000
SESSION_PRUNE_INTERVAL_MS=600000
MAX_SESSION_MESSAGES=20

# Ingest endpoint rate limiting
INGEST_RATE_LIMIT_WINDOW_MS=900000
INGEST_RATE_LIMIT_MAX=10
